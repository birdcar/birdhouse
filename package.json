{
  "name": "@birdcar/birdhouse",
  "version": "0.1.8",
  "description": "CLI tool for managing GitHub workflow templates",
  "author": "birdcar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdcar/birdhouse.git"
  },
  "keywords": [
    "github",
    "actions",
    "workflow",
    "templates",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "birdhouse": "dist/index.js",
    "bh": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --format esm && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bin": "bun build src/index.ts --compile --outfile dist/bh",
    "build:all": "bun run scripts/build-all.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@actions/artifact": "^5.0.3",
    "@actions/attest": "^2.2.1",
    "@actions/cache": "^5.0.4",
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.1",
    "@actions/glob": "^0.5.0",
    "@actions/http-client": "^3.0.2",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^3.0.1",
    "clipanion": "^4.0.0-rc.4",
    "isomorphic-git": "^1.36.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typanion": "^3.14.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.2"
  }
}
